# HTTP port. Railway injects PORT automatically — do not hardcode in production.
PORT=3001

# Supabase connection pooler URL (Transaction mode, port 6543). Used by the running API.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase direct connection URL (Session mode, port 5432). Used by Prisma migrations and seed only.
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Firebase Admin SDK — service account credentials from Firebase Console → Project settings → Service accounts.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key as a single line with literal \n characters, or use real newlines in Railway's multiline editor.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email of the Firebase demo user. Must match the account created in Firebase Auth and VITE_DEMO_EMAIL on the web app.
DEMO_EMAIL=awsaf@example.com

# AI provider configuration. Only the key for your chosen AI_PROVIDER is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=4
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=3600000

# Comma-separated allowed browser origins for REST and Socket.io CORS.
# Production example: https://zeroone.vercel.app
# Local dev automatically also allows http://localhost:5173 and http://127.0.0.1:5173.
WEB_ORIGIN=http://localhost:5173

# Background fake squad activity for demos. Leave false in production unless you want it.
AMBIENT_SQUAD_ACTIVITY=false

# Expose /dev routes in production. Keep false unless you explicitly need them.
ENABLE_DEV_ROUTES=false

# Set to production on Railway. Vercel sets this for the frontend build automatically.
# NODE_ENV=production
