# Public — baked into the client bundle at build time. Set these in Vercel Environment Variables.

# Base URL of the deployed Railway API (no trailing slash).
VITE_API_ORIGIN=http://localhost:3001

# Socket.io server origin. Usually the same as VITE_API_ORIGIN.
VITE_SOCKET_ORIGIN=http://localhost:3001

# Firebase web app config from Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Demo login button credentials. Must match a real Firebase Auth email/password user.
# The same email must exist as a seeded user in the production database (DEMO_EMAIL on the API).
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
